<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Real skips for the opt-in Wine integration proofs: without MECHAGON_WINE_IT=1 they must show
         as SKIPPED, never counted as passing (WP2 fixrunde F5). [SkippableFact] + Skip.IfNot. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WowLauncher\WowLauncher.csproj" />
  </ItemGroup>

  <!-- WP4 contract fixtures: synthetic manifest JSON (no real URLs/hashes) copied next to the test
       assembly so the deserialisation + behaviour tests read the exact on-wire shape WP6 will serve. -->
  <ItemGroup>
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The detached manifest signature is the cross-language interop fixture (python signs, the
         launcher verifies) — it has to travel next to its manifest or the proof cannot run. -->
    <None Include="fixtures\*.sig" CopyToOutputDirectory="PreserveNewest" />
    <!-- Not a fixture: the actual manifest that gets uploaded, LINKED rather than copied. A copy
         would drift, and the drift would be invisible — the tests would keep proving a shape the
         published file no longer has. -->
    <None Include="..\deploy\manifest-1.6.4-candidate.json"
          Link="fixtures\manifest-release-candidate.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
