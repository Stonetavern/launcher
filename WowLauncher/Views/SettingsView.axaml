<!--
  OPTIONEN = was der LAUNCHER macht. Nichts von Realms.

  Warum getrennt (Owner-Entscheidung 2026-08-04, zweiter Anlauf — beim ersten hatte ich es genau
  andersherum gebaut): auf einer Seite standen zwei Dinge, die nichts miteinander zu tun haben.
  „Welchen Realm spiele ich, welchen lege ich an" ist eine Frage ans Spiel. „Wohin installiert der
  Launcher, wo liegt die exe, gleicht er mein Profil ab" ist eine Frage ans Programm und gilt fuer
  alle Realms zugleich. Untereinander in einer Spalte las sich das so, als gehoere der
  Installationsordner zum gerade gewaehlten Realm — was falsch ist.

  Realms leben an der Leiste links: die Lampen sind die Realms, das Plus oeffnet ihre Verwaltung
  (auswaehlen, Client zuordnen, anlegen, entfernen). Unten steht der Weg dorthin, damit niemand sie
  hier sucht.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WowLauncher.Localization"
             xmlns:m="using:WowLauncher.Models"
             xmlns:vm="using:WowLauncher.ViewModels"
             x:Class="WowLauncher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Border Background="{StaticResource StoneBase}">
        <ScrollViewer>
            <StackPanel Margin="40,32" Spacing="20" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Tr Settings_LauncherTitle}" FontSize="24"
                           FontFamily="{StaticResource FontDisplay}"
                           Foreground="{StaticResource ParchmentPrimary}"/>

                <!-- Einstellungen werden als angewendet gezeigt, auch wenn die Konfigurationsdatei
                     nicht schreibbar ist. Diese Zeile sagt es. -->
                <Border IsVisible="{Binding HasSaveWarning}" Background="{StaticResource StoneSurface}"
                        BorderBrush="{StaticResource ParchmentSecondary}" BorderThickness="1" Padding="12,10">
                    <TextBlock Text="{Binding SaveWarning}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentPrimary}"/>
                </Border>

                <!-- Die Sprache der OBERFLAECHE. Der Waehler unten in der Leiste ist die Sprache
                     des SPIELS — bis 2026-08-04 war das ein einziger Waehler fuer beides, und wer
                     den Client englisch spielt (wegen Addons und Anleitungen), bekam damit
                     zwangsweise auch einen englischen Launcher. -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr Settings_Language}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <ComboBox ItemsSource="{Binding LauncherLanguages}"
                              SelectedItem="{Binding SelectedLauncherLanguage, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{loc:Tr Settings_Language}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="m:LauncherLanguageChoice">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr Settings_WowPath}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <TextBox Text="{Binding WowExecutablePath}" FontFamily="{StaticResource FontMono}"
                             AutomationProperties.Name="{loc:Tr Settings_WowPath_A11y}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr Settings_InstallFolder}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Settings_InstallFolder_Browse}"
                                Command="{Binding BrowseInstallFolderCommand}" Margin="8,0,0,0"
                                AutomationProperties.Name="{loc:Tr Settings_InstallFolder_Browse_A11y}"/>
                        <TextBox Text="{Binding PreferredInstallRoot}" FontFamily="{StaticResource FontMono}"
                                 PlaceholderText="{loc:Tr Settings_InstallFolder_Placeholder}"
                                 AutomationProperties.Name="{loc:Tr Settings_InstallFolder_A11y}"/>
                    </DockPanel>
                    <TextBlock Text="{loc:Tr Settings_InstallFolder_Hint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                </StackPanel>

                <!-- "Ich habe das Spiel schon." Die Funktion gab es laengst, aber nur als gedaempfte
                     Zeile unter dem Spielen-Knopf, und die steht dort nur, solange kein Client
                     eingetragen ist. Wer sie einmal ueberliest, laedt Gigabytes neu, die auf der
                     Platte liegen (Owner-Befund 2026-08-04: "locaten feature des installed ordners").
                     Der Knopf ist derselbe Befehl wie dort, nicht ein zweiter. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowLocateClient}">
                    <TextBlock Text="{loc:Tr Settings_LocateClient}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <Button Content="{loc:Tr Play_Locate}" Command="{Binding LocateClientCommand}"
                            IsEnabled="{Binding CanLocateClient}" HorizontalAlignment="Left"
                            AutomationProperties.Name="{loc:Tr Play_Locate_A11y}"/>
                    <TextBlock Text="{loc:Tr Settings_LocateClient_Hint}" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding CanLocateClient}"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <!-- Der Knopf ist grau, weil fuer diesen Realm schon ein Client eingetragen ist.
                         Ein grauer Knopf ohne Grund ist eine Sackgasse, also steht der Grund da. -->
                    <TextBlock Text="{loc:Tr Settings_LocateClient_Done}" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding !CanLocateClient}"
                               Foreground="{StaticResource ParchmentFaint}"/>
                </StackPanel>

                <!-- Womit gestartet wird (Owner 2026-08-04, wiederholt 2026-08-05). Nur unter Linux:
                     Windows startet nativ, macOS loest ueber GPTK auf.

                     Die Statuszeile ist hier NICHT Beiwerk, sondern der eigentliche Punkt. Die Wahl
                     allein waere ein Knopf, dessen Wirkung man nicht sieht; was gefehlt hat, war
                     nicht die Auswahl, sondern dass der Launcher verschweigt, womit er startet - und
                     erst recht, wenn er auf etwas anderes zurueckfaellt als gewuenscht. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowLinuxRuntime}">
                    <TextBlock Text="{loc:Tr Settings_Runtime}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <ComboBox ItemsSource="{Binding LinuxRuntimeOptions}"
                              SelectedItem="{Binding SelectedLinuxRuntimeOption}"
                              HorizontalAlignment="Left" MinWidth="240"
                              AutomationProperties.Name="{loc:Tr Settings_Runtime_A11y}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding LinuxRuntimeCustomPath}"
                             IsVisible="{Binding ShowLinuxRuntimeCustomPath}"
                             PlaceholderText="{loc:Tr Settings_Runtime_CustomPlaceholder}"
                             AutomationProperties.Name="{loc:Tr Settings_Runtime_CustomPath_A11y}"/>
                    <TextBlock Text="{Binding LinuxRuntimeStatus}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentPrimary}"/>
                    <TextBlock Text="{loc:Tr Settings_Runtime_Hint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentFaint}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <CheckBox Content="{loc:Tr Settings_ProfileSync}"
                              IsChecked="{Binding ProfileSyncEnabled}"/>
                    <TextBlock Text="{loc:Tr Settings_ProfileSync_Hint}" FontSize="12" TextWrapping="Wrap"
                               Margin="26,0,0,0"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                </StackPanel>

                <!-- Nur unter Linux, und nur auf Knopfdruck: legt Menueeintrag und Symbol an.
                     Laeuft nie von allein. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowDesktopIntegration}">
                    <TextBlock Text="{loc:Tr Settings_DesktopIntegration}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <Button Content="{Binding AddToMenuLabel}" Command="{Binding AddToMenuCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{loc:Tr Settings_AddToMenu_A11y}"/>
                    <TextBlock Text="{loc:Tr Settings_DesktopIntegration_Hint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentFaint}"/>
                    <TextBlock Text="{Binding DesktopIntegrationError}" IsVisible="{Binding HasDesktopIntegrationError}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                </StackPanel>

                <!-- Welche Fassung, und wann das zuletzt jemand erfahren hat. Steht ueber dem
                     Startbericht, weil es die haeufigere Frage beantwortet und weil der Bericht
                     dieselbe Zeile mitnimmt. -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowReleaseStatus}">
                    <TextBlock Text="{loc:Tr Settings_Release}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <TextBlock Text="{Binding ReleaseStatusLine}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentPrimary}"/>
                    <TextBlock Text="{Binding ReleaseCheckLine}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentFaint}"/>
                </StackPanel>

                <!-- Startbericht zum Kopieren. Steht bewusst UNTER der Laufzeit-Wahl: was dort
                     entschieden wird, ist die haeufigste Zeile, die im Bericht gebraucht wird.
                     Der Text steht sichtbar da, nicht nur hinter dem Knopf - wer etwas weitergeben
                     soll, darf vorher hineinsehen. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowStartReport}">
                    <TextBlock Text="{loc:Tr Settings_StartReport}" FontSize="13"
                               Foreground="{StaticResource ParchmentSecondary}"/>
                    <TextBlock Text="{loc:Tr Settings_StartReport_Hint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentFaint}"/>
                    <Border Background="#1A000000" CornerRadius="4" Padding="10,8">
                        <SelectableTextBlock Text="{Binding StartReportText}"
                                             FontFamily="monospace" FontSize="11"
                                             TextWrapping="Wrap"
                                             Foreground="{StaticResource ParchmentSecondary}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr Settings_StartReport_Copy}"
                                Command="{Binding CopyStartReportCommand}"
                                AutomationProperties.Name="{loc:Tr Settings_StartReport_Copy_A11y}"/>
                        <TextBlock Text="{Binding StartReportNote}" IsVisible="{Binding HasStartReportNote}"
                                   FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource ParchmentPrimary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Der Weg zu den Realms, damit niemand sie hier sucht. -->
                <Border BorderBrush="{StaticResource ParchmentSecondary}" BorderThickness="0,1,0,0"
                        Padding="0,16,0,0">
                    <TextBlock Text="{loc:Tr Settings_RealmsElsewhere}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ParchmentFaint}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
